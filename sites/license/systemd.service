# Rendered by provision/30-site.sh; placeholders between at-signs come from site.conf.
# The keys are root-only files in /etc/codelab/@SITE@/, handed to the service as credentials.
[Unit]
Description=Licence service (@DOMAIN@)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
ExecStart=@BASE@/current/licensed serve
EnvironmentFile=@BASE@/shared/.env
LoadCredential=signing.key:/etc/codelab/@SITE@/signing.key
LoadCredential=session.key:/etc/codelab/@SITE@/session.key
Restart=on-failure
RestartSec=3

DynamicUser=yes
StateDirectory=@SITE@
StateDirectoryMode=0700
MemoryMax=256M
TasksMax=128

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
