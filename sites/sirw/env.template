APP_NAME="RW 05 Tanjungrejo"
APP_ENV=production
APP_KEY=${SIRW_APP_KEY}
APP_DEBUG=false
APP_URL=${SIRW_APP_URL}
FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sirw
DB_USERNAME=sirw
DB_PASSWORD="${SIRW_DB_PASSWORD}"

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# "log" discards mail: it is written at debug level, below LOG_LEVEL.
MAIL_MAILER=${SIRW_MAIL_MAILER}
MAIL_HOST=${SIRW_MAIL_HOST}
MAIL_PORT=${SIRW_MAIL_PORT}
MAIL_USERNAME="${SIRW_MAIL_USERNAME}"
MAIL_PASSWORD="${SIRW_MAIL_PASSWORD}"
MAIL_ENCRYPTION=${SIRW_MAIL_ENCRYPTION}
MAIL_FROM_ADDRESS="${SIRW_MAIL_FROM}"
MAIL_FROM_NAME="${APP_NAME}"

# Used by the production seeder. An existing account keeps its password.
SEED_ADMIN_EMAIL=${SIRW_ADMIN_EMAIL}
SEED_ADMIN_PASSWORD="${SIRW_ADMIN_PASSWORD}"

LETTERS_ENABLED=${SIRW_LETTERS_ENABLED}
TURNSTILE_SITE_KEY="${SIRW_TURNSTILE_SITE_KEY}"
TURNSTILE_SECRET_KEY="${SIRW_TURNSTILE_SECRET_KEY}"

# Uploads: "public" and "local" keep them on this server, "r2_public" and "r2_private" use Cloudflare R2.
# Variable names on the right have no digit, or render-env.sh skips them.
UPLOADS_PUBLIC_DISK=${SIRW_UPLOADS_PUBLIC_DISK}
UPLOADS_PRIVATE_DISK=${SIRW_UPLOADS_PRIVATE_DISK}
R2_ACCOUNT_ID="${SIRW_FILES_ACCOUNT_ID}"
R2_ACCESS_KEY_ID="${SIRW_FILES_KEY_ID}"
R2_SECRET_ACCESS_KEY="${SIRW_FILES_SECRET}"
R2_PUBLIC_BUCKET="${SIRW_FILES_PUBLIC_BUCKET}"
R2_PRIVATE_BUCKET="${SIRW_FILES_PRIVATE_BUCKET}"
R2_PUBLIC_URL="${SIRW_FILES_PUBLIC_URL}"
