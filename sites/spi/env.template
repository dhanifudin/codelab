APP_NAME="SPI Polinema"
APP_ENV=production
APP_KEY=${SPI_APP_KEY}
APP_DEBUG=false
APP_URL=${SPI_APP_URL}

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spi
DB_USERNAME=spi
DB_PASSWORD="${SPI_DB_PASSWORD}"

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=${SPI_SESSION_SECURE}

MAIL_MAILER=${SPI_MAIL_MAILER}
MAIL_HOST=${SPI_MAIL_HOST}
MAIL_PORT=${SPI_MAIL_PORT}
MAIL_USERNAME="${SPI_MAIL_USERNAME}"
MAIL_PASSWORD="${SPI_MAIL_PASSWORD}"
MAIL_ENCRYPTION=${SPI_MAIL_ENCRYPTION}
MAIL_FROM_ADDRESS="${SPI_MAIL_FROM}"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SCAN_AUDIT_TO="${SPI_MAIL_SCAN_AUDIT_TO}"

NOCAPTCHA_SECRET="${SPI_NOCAPTCHA_SECRET}"
NOCAPTCHA_SITEKEY="${SPI_NOCAPTCHA_SITEKEY}"
