# Rendered by provision/30-site.sh to /etc/systemd/system/@SITE@-files-backup.timer.
[Unit]
Description=@SITE@: nightly copy of uploads from R2

[Timer]
OnCalendar=*-*-* 02:15:00 Asia/Jakarta
RandomizedDelaySec=10min
# Run after boot if the server was off at that time.
Persistent=true

[Install]
WantedBy=timers.target
